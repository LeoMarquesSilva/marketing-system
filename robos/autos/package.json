{
  "name": "orqestrai-robo-autos",
  "version": "0.1.0",
  "private": true,
  "description": "Robô que baixa os autos no tribunal e entrega ao ORQESTRAI. Roda fora da Vercel.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "robo": "tsx --env-file=.env src/index.ts",

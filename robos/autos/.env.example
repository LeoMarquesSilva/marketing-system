# Endereço do ORQESTRAI (produção ou o servidor local) e o token do robô.
# O token é o mesmo valor de ROBO_AUTOS_TOKEN configurado na Vercel (mínimo de 24 caracteres).
ORQESTRAI_URL=http://localhost:3000
ROBO_AUTOS_TOKEN=

# Nome desta máquina, como aparece na ficha do processo.
ROBO_NOME=mac-controladoria

# Como o advogado entra no e-SAJ:
#   certificado  certificado digital pelo Web Signer (o robô escolhe o certificado e clica em Entrar)
#   senha        CPF e senha (o robô preenche e para no código de verificação)
#   manual       uma pessoa faz o login inteiro na janela do robô
ESAJ_LOGIN=certificado
# Trecho do nome do certificado, como aparece na lista do e-SAJ (modo certificado).
ESAJ_CERTIFICADO=
# Só no modo senha. A credencial é do advogado: fica neste arquivo, nesta máquina, e em nenhum outro lugar.
ESAJ_USUARIO=
ESAJ_SENHA=

# Opcionais
# NAVEGADOR_CANAL=chrome          navegador instalado que o robô abre (chrome, msedge) ou "chromium" (o do Playwright)
# INTERVALO_SEGUNDOS=30           espera entre consultas à fila quando ela está vazia
# PAUSA_ENTRE_PEDIDOS_SEGUNDOS=20 respiro entre um processo e outro, para não sobrecarregar o tribunal
# ESPERA_PESSOA_MINUTOS=15        quanto tempo o robô espera a pessoa concluir login, código ou CAPTCHA
# GERACAO_PDF_MINUTOS=20          quanto tempo esperar o tribunal montar o PDF dos autos

# Endereço do ORQESTRAI (produção ou o servidor local) e o token do robô.
# O token é o mesmo valor de ROBO_AUTOS_TOKEN configurado na Vercel (mínimo de 24 caracteres).
ORQESTRAI_URL=http://localhost:3000
ROBO_AUTOS_TOKEN=

# Nome desta máquina, como aparece na ficha do processo.
ROBO_NOME=mac-controladoria

# Como o advogado entra no e-SAJ:
#   certificado  certificado digital pelo Web Signer (o robô escolhe o certificado e clica em Entrar)
#   senha        CPF e senha (o robô preenche e para no código de verificação)
#   manual       uma pessoa faz o login inteiro na janela do robô
ESAJ_LOGIN=certificado
# Trecho do nome do certificado, como aparece na lista do e-SAJ (modo certificado).
ESAJ_CERTIFICADO=
# Só no modo senha. A credencial é do advogado: fica neste arquivo, nesta máquina, e em nenhum outro lugar.
ESAJ_USUARIO=
ESAJ_SENHA=

# Opcionais
# NAVEGADOR_CANAL=chrome          navegador instalado que o robô abre (chrome, msedge) ou "chromium" (o do Playwright)
# NAVEGADOR_EXECUTAVEL=           caminho do navegador, se ele não estiver no lugar padrão
# INTERVALO_SEGUNDOS=30           espera entre consultas à fila quando ela está vazia
# PAUSA_ENTRE_PEDIDOS_SEGUNDOS=20 respiro entre um processo e outro, para não sobrecarregar o tribunal
# ESPERA_PESSOA_MINUTOS=15        quanto tempo o robô espera a pessoa concluir login, código ou CAPTCHA
# GERACAO_PDF_MINUTOS=20          quanto tempo esperar o tribunal montar o PDF dos autos
# CAPA_DATAJUD=sim                com a fila de autos vazia, completa a capa dos processos pelo DataJud (nao desliga)
# PAUSA_CAPA_SEGUNDOS=30          pausa entre duas consultas ao DataJud (ele é lento e recusa rajadas)

# eproc do TJSP: certificado, senha ou manual (sem valor, vale o ESAJ_LOGIN).
EPROC_LOGIN=
EPROC_USUARIO=
EPROC_SENHA=

# eproc do TJRJ (cadastro próprio no tribunal): certificado, senha ou manual. Sem valor, vale o EPROC_LOGIN
# (e "senha" sem usuário e senha do TJRJ vira "manual"). O código de 2 fatores vem do webhook com ?sistema=eproc-tjrj.
EPROC_TJRJ_LOGIN=
EPROC_TJRJ_USUARIO=
EPROC_TJRJ_SENHA=

# DCP (Portal de Serviços) e PJe do TJRJ: rascunhos desligados, sem variáveis de login. O login nesses sistemas é
# sempre de uma pessoa, na janela do robô (o robô não digita senha nem código). Para conhecer as telas:
#   npm run mapear -- dcp <CNJ>    ou    npm run mapear -- pje <CNJ> [2g]
# O mapear usa o mesmo perfil do Chrome (pare o robô antes), espera ESPERA_PESSOA_MINUTOS por cada passo da pessoa
# e grava capturas e JSON em diagnostico/. Detalhes no README.

# Fonte do código de 2 fatores (webhook do n8n que gera o TOTP). O robô manda ?sistema=eproc (TJSP) ou
# ?sistema=eproc-tjrj (TJRJ). Vazio = espera a pessoa.
ROBO_2FA_WEBHOOK_URL=
ROBO_2FA_WEBHOOK_HEADER=x-robo-token
ROBO_2FA_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------------------------
# Servidor (contêiner no Easypanel) e certificado em arquivo. Guia: docs/easypanel.md.
# Sem estas variáveis, o robô funciona como sempre (Chrome comum, perfil nesta pasta).
# ---------------------------------------------------------------------------------------------
# Conectores que este robô atende (vazio = todos). Ex.: "eproc" no servidor e "esaj" no Mac.
# ROBO_CONECTORES=
# comum (abre o Chrome e se conecta; aceita a extensão Web Signer) ou playwright (o do servidor;
# aceita certificado em arquivo). Com certificado em arquivo, o padrão passa a ser playwright.
# NAVEGADOR_MODO=comum
# NAVEGADOR_HEADLESS=nao          sim = sem janela (só playwright); aí ninguém resolve login, código ou CAPTCHA
# NAVEGADOR_ARGS=                 argumentos extras do navegador, separados por espaço
# PASTA_DADOS=                    onde ficam perfil/, downloads/ e diagnostico/ (no contêiner, /dados)
# TELA_REMOTA_URL=                endereço da tela remota (noVNC), mostrado no log quando o robô precisa de alguém

# Certificado A1 (.pfx) para o login por certificado do eproc (só no modo playwright). Use UMA das fontes:
#  a) arquivo e senha:
# CERTIFICADO_PFX=
# CERTIFICADO_SENHA=
# CERTIFICADO_SENHA_ARQUIVO=      alternativa à senha na variável: arquivo com a senha
#  b) pasta gravada pelo painel de robôs (senha cifrada com a chave pública do robô):
# CERTIFICADO_PASTA=
# CERTIFICADO_CHAVE_PRIVADA_ARQUIVO=
# Origens que recebem o certificado (padrão: https://certificado-sso.tjsp.jus.br). Para o eproc do TJRJ, acrescente
# a origem do login por certificado dele, separada por vírgula (endereço ainda não conferido; veja o README).
# CERTIFICADO_ORIGENS=

# Tela remota do contêiner (noVNC). Sem senha, a tela remota fica desligada.
# VNC_SENHA=
# VNC_SENHA_ARQUIVO=

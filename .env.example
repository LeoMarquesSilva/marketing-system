# Supabase (Settings > API no painel supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Server-only — nunca expor no frontend
SUPABASE_SERVICE_ROLE_KEY=

# SIOE Pro — leitura server-side para sincronizações
SIOE_SUPABASE_URL=https://pzfxmlidwdmsqfwrxdbd.supabase.co
SIOE_SUPABASE_SERVICE_ROLE_KEY=

# Autorização dos cron jobs da Vercel
CRON_SECRET=

# Processos: robô de autos (robos/autos). O mesmo valor vai no .env da máquina do robô; sem ele as rotas /api/robos/autos respondem 503.
ROBO_AUTOS_TOKEN=
# Opcional: chave da OpenAI só para a leitura dos autos (sem ela, vale a chave geral).
OPENAI_API_KEY_PROCESSOS=
